<?xml version="1.0" encoding="utf-8"?>
<!-- © EFS Studio -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<View
        android:id="@+id/gradientBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen"
        android:visibility="gone" />

        <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wp_main" />

    <!-- przyciemnienie podglądu, zeby tekst pozostał czytelny -->
    <View
        android:id="@+id/overlayDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A131318" />

    <View
        android:id="@+id/overlayLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_left" />

    <View
        android:id="@+id/overlayBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

       <!-- nagłówek: zegar i data po lewej, zakładki jako pastylki po prawej -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingRight="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="26dp"
                android:paddingTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="54sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.02"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="12" />

                <TextView
                    android:id="@+id/clockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:textSize="15sp"
                    android:textColor="#CCFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tabYou"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_pill_selector"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/tab_you"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_pill_selector"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/tab_settings"
                android:textSize="15sp"
                android:textColor="#CCFFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Duży zegar na środku — używany przez launchery Minimal, Logotypy, Dok i Reflektor -->
            <LinearLayout
                android:id="@+id/clockHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/clockHeroTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="104sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.03"
                    android:textColor="#FFFFFFFF"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="18" />

                <TextView
                    android:id="@+id/clockHeroDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="#D9FFFFFF" />
            </LinearLayout>
            <!-- EKRAN: Dla Ciebie -->
            <LinearLayout
                android:id="@+id/screenHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="10dp"
                android:gravity="bottom">

                <!-- Układy inne niż siatka (ikony, minimal, reflektor, mozaika, panel, dok) buduje
                     HomeLayouts; siatka korzysta z widoków poniżej. -->
                <LinearLayout
                    android:id="@+id/homeHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/continueTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/row_continue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/continueScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/rowContinue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false" />
                </HorizontalScrollView>


                <TextView
                    android:id="@+id/rowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_apps"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:id="@+id/rowCards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- EKRAN: Ustawienia -->
            <LinearLayout
                android:id="@+id/screenSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_settings"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/settingsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <!-- Panel wyglądu wysuwany z prawej strony (jak w Novej) -->
    <View
        android:id="@+id/panelDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="18dp"
        android:background="#F00E1014"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zmień wygląd"
            android:textSize="24sp"
            android:textColor="#FFFFFFFF"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/panelRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Strzałki zmieniają ustawienie. Zmiany zapisują się od razu."
            android:textSize="11sp"
            android:textColor="#8AFFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/picker"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#F00E1014"
        android:padding="20dp"
        android:visibility="gone" />
</FrameLayout>






















